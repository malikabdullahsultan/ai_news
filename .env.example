# Zero-cost defaults. GitHub Actions supplies GITHUB_TOKEN automatically.
AI_PROVIDER=github-models
AI_MODEL=auto
FREE_ONLY=true
TIMEZONE=Asia/Hong_Kong
REPORT_TIME=03:30
MAX_RESEARCH_ITEMS=24
MAX_SOURCE_FETCHES=36
MAX_PAPER_ITEMS=6
RECENT_REPORT_CONTEXT_DAYS=3
MAX_CONTINUATIONS=2

# Optional advanced provider. Never required and never used when FREE_ONLY=true.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
