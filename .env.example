# Zero-cost defaults. Put SAMBANOVA_API_KEY in GitHub Actions Secrets.
AI_PROVIDER=sambanova
AI_MODEL=auto
FREE_ONLY=true
SAMBANOVA_API_KEY=
TIMEZONE=Asia/Hong_Kong
REPORT_TIME=03:30
MAX_RESEARCH_ITEMS=24
MAX_SOURCE_FETCHES=36
MAX_PAPER_ITEMS=6
RECENT_REPORT_CONTEXT_DAYS=3
MAX_CONTINUATIONS=2
MAX_PROVIDER_FALLBACKS=2
MAX_OUTPUT_TOKENS=14000

# Optional advanced provider. Never required and never used when FREE_ONLY=true.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
